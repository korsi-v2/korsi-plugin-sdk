{
  "name": "@korsi/plugin-ui",
  "version": "0.1.0",
  "description": "Make a Korsi plugin page look and read like Korsi: the theme as CSS variables, Korsi's fonts, and dates and digits as the organization writes them.",
  "keywords": [
    "korsi",
    "plugin",
    "theme",
    "rtl",
    "jalali",
    "persian"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@korsi/bridge": "0.1.0"
  }
}
