          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "$ref": "#/components/schemas/CaseStatus"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object",
      "required": [
        "id",
        "title",
        "status"
      ],
      "title": "CaseView"
    },
    "ActivityItem": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "title": "ActivityItem"
    },
    "ActivityPage": {
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ActivityItem"
          },
          "title": "Items",
          "default": []
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        }
      },
      "type": "object",
      "title": "ActivityItemPage"
    },
    "CalendarEvent": {
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "title": "CalendarEvent"
    },
    "CalendarWindow": {
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/CalendarEvent"
          },
          "default": []
        }
      },
      "type": "object",
      "title": "CalendarWindow"
    },
    "MemorySearch": {
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "default": 10
        }
      },
      "type": "object",
      "required": [
        "query"
      ],
      "title": "MemorySearch"
    },
    "MemoryHit": {
      "properties": {
        "text": {
          "type": "string"
        },
        "score": {
          "type": "number"
        }
      },
      "type": "object",
      "required": [
        "text",
        "score"
      ],
      "title": "MemoryHit"
