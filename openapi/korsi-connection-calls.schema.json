{
  "$defs": {
    "CalendarAnswer": {
      "additionalProperties": false,
      "properties": {
        "result": {
          "default": null,
          "title": "Result"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/CallError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CalendarAnswer",
      "type": "object"
    },
    "CalendarCall": {
      "additionalProperties": false,
      "description": "One operation of Korsi's calendar engine, carried out on the person's calendar.\n\n``op`` and ``args`` follow the engine's calendar port, one to one; the plugin answers with what\nthat method returns. Korsi's engine does everything else -- which events go where, what the\nperson changed on each side, what to send back.",
      "properties": {
        "call": {
          "const": "connection.calendar",
          "default": "connection.calendar",
          "title": "Call",
          "type": "string"
        },
        "call_id": {
          "format": "uuid",
          "title": "Call Id",
          "type": "string"
        },
        "installation_id": {
          "format": "uuid",
          "title": "Installation Id",
          "type": "string"
        },
        "connection_id": {
          "format": "uuid",
          "title": "Connection Id",
          "type": "string"
        },
        "connection_key": {
          "maxLength": 48,
          "title": "Connection Key",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        },
        "locale": {
          "maxLength": 16,
          "title": "Locale",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "title": "Timezone",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Values",
          "type": "object"
        },
        "secrets": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Secrets",
          "type": "object"
        },
        "settings": {
          "additionalProperties": true,
          "title": "Settings",
          "type": "object"
        },
        "deadline_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Deadline Seconds",
          "type": "integer"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "op": {
          "pattern": "^[a-z][a-z_]{1,63}$",
          "title": "Op",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        }
      },
      "required": [
        "call_id",
        "installation_id",
        "connection_id",
        "connection_key",
        "user_id",
        "locale",
        "timezone",
        "deadline_seconds",
        "issued_at",
        "op"
      ],
      "title": "CalendarCall",
      "type": "object"
    },
    "CallError": {
      "additionalProperties": false,
      "description": "A refusal, in words that may be shown to the person -- never a secret.",
      "properties": {
        "code": {
          "$ref": "#/$defs/CallErrorCode"
        },
        "message": {
          "default": "",
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Seconds"
        }
      },
      "required": [
        "code"
      ],
      "title": "CallError",
      "type": "object"
    },
    "CallErrorCode": {
      "description": "Why a plugin could not do what Korsi asked. Korsi decides what follows from this alone.",
      "enum": [
        "auth_failed",
        "unreachable",
        "throttled",
        "invalid_state",
        "not_found",
        "conflict",
        "bad_request",
        "unprovisioned",
        "internal"
      ],
      "title": "CallErrorCode",
      "type": "string"
    },
    "ConnectionCapability": {
      "description": "What a connection brings into Korsi, which Korsi then does itself (ADR-0067).\n\nThe plugin speaks the other system's language and nothing else: Korsi asks it for changes and\napplies them, as the person who connected, in its own jobs.",
      "enum": [
        "mail",
        "calendar",
        "calendar_attendees"
      ],
      "title": "ConnectionCapability",
      "type": "string"
    },
    "EventStatus": {
      "description": "Where an event stands.\n\n``CANCELLED`` is why an enum earns its place over a boolean. A cancelled meeting is not a\ndeleted one: the slot was taken, somebody may have planned around it, and the honest thing to\nshow is a cancelled entry rather than an empty afternoon. Deleting the row asserts it never\nexisted.",
      "enum": [
        "confirmed",
        "tentative",
        "cancelled"
      ],
      "title": "EventStatus",
      "type": "string"
    },
    "ExternalCalendarEvent": {
      "additionalProperties": false,
      "description": "One event, as it should look in the external calendar.\n\nThe provider assigns its own ids: on a create ``event_id`` is only Korsi's name for the copy,\nand the provider answers with its own id, which every later update names. What makes a write\nsafe to repeat is ``properties``: before it creates, Korsi looks its copies up by its own\n``korsi_event`` property (``list_events``), so a retried create finds the copy rather than\nmaking a second one.\n\n``recurrence`` holds RFC 5545 ``RRULE`` and ``EXDATE`` lines, built by the calendar domain from\nits own rule. ``properties`` are private to the owning calendar and are how a copy says which\nKorsi event, version and generation it is.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "start": {
          "$ref": "#/$defs/ExternalEventTime"
        },
        "end": {
          "$ref": "#/$defs/ExternalEventTime"
        },
        "status": {
          "$ref": "#/$defs/EventStatus",
          "default": "confirmed"
        },
        "recurrence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Recurrence",
          "type": "array"
        },
        "reminder_minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reminder Minutes"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "properties": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Properties",
          "type": "object"
        },
        "attendees": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attendees"
        }
      },
      "required": [
        "event_id",
        "title",
        "start",
        "end"
      ],
      "title": "ExternalCalendarEvent",
      "type": "object"
    },
    "ExternalCalendarSummary": {
      "additionalProperties": false,
      "description": "One calendar in the person's external account, as the chooser lists it.",
      "properties": {
        "calendar_id": {
          "title": "Calendar Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "primary": {
          "default": false,
          "title": "Primary",
          "type": "boolean"
        },
        "writable": {
          "default": false,
          "title": "Writable",
          "type": "boolean"
        },
        "colour": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colour"
        },
        "time_zone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Zone"
        }
      },
      "required": [
        "calendar_id",
        "name"
      ],
      "title": "ExternalCalendarSummary",
      "type": "object"
    },
    "ExternalChanges": {
      "additionalProperties": false,
      "description": "One read of what changed in the external calendar.\n\nOne page: its items, the cursor the next read starts from -- the plugin's own, opaque to Korsi\n-- and whether more is waiting now. A cursor Korsi sends that is no longer good is answered\n``invalid_state``, and Korsi reads the whole window again.",
      "properties": {
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExternalEventData"
          },
          "title": "Items",
          "type": "array"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "more": {
          "default": false,
          "title": "More",
          "type": "boolean"
        }
      },
      "title": "ExternalChanges",
      "type": "object"
    },
    "ExternalEventData": {
      "additionalProperties": false,
      "description": "One event as the external calendar holds it, in full: what a change read back carries.\n\nAn occurrence of a repeating event arrives as its own item with ``recurring_event_id`` set,\nbecause what Korsi imports is the occurrences a person will actually see, not the provider's\nrule for producing them.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "etag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Etag"
        },
        "html_link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Html Link"
        },
        "cancelled": {
          "default": false,
          "title": "Cancelled",
          "type": "boolean"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExternalEventTime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExternalEventTime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/EventStatus",
          "default": "confirmed"
        },
        "busy": {
          "default": true,
          "title": "Busy",
          "type": "boolean"
        },
        "recurring_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recurring Event Id"
        },
        "conference_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conference Url"
        },
        "properties": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Properties",
          "type": "object"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "meeting_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meeting Uid"
        },
        "attendees": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attendees"
        },
        "attendee_names": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attendee Names",
          "type": "object"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "ExternalEventData",
      "type": "object"
    },
    "ExternalEventPatch": {
      "additionalProperties": false,
      "description": "A change to an event that is the person's own in the external calendar.\n\nPartial on purpose: such an event carries things Korsi does not hold -- guests from outside\nthe organization, a conference, a colour -- and replacing it whole would erase them. Only what\nKorsi changed is sent. Its people the same way: the colleagues named on it in Korsi who are not\nthere yet, never the whole list, and nobody is ever taken off (ADR-0077).\n\n**Exactly the fields a plugin is told of.** A plugin validates the patch strictly, so a field\nhere that its contract does not name refuses every patch: `remove_attendees`, declared and\nnever used, did that to each change to a person's own Exchange event from 2026-10-26 to\n2026-11-10 (`provider.rejected: Extra inputs are not permitted`).",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "start": {
          "$ref": "#/$defs/ExternalEventTime"
        },
        "end": {
          "$ref": "#/$defs/ExternalEventTime"
        },
        "status": {
          "$ref": "#/$defs/EventStatus",
          "default": "confirmed"
        },
        "properties": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Properties",
          "type": "object"
        },
        "add_attendees": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Add Attendees",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "title",
        "start",
        "end"
      ],
      "title": "ExternalEventPatch",
      "type": "object"
    },
    "ExternalEventState": {
      "additionalProperties": false,
      "description": "What the external calendar says about one event it holds.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "etag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Etag"
        },
        "html_link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Html Link"
        },
        "cancelled": {
          "default": false,
          "title": "Cancelled",
          "type": "boolean"
        },
        "properties": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Properties",
          "type": "object"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "attendees": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attendees"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "ExternalEventState",
      "type": "object"
    },
    "ExternalEventTime": {
      "additionalProperties": false,
      "description": "One end of an event: a date for an all-day event, an instant and its zone otherwise.\n\n``day`` rather than ``date``: a field named after the type it holds shadows that type while the\nmodel's annotations are resolved, and the annotation then means ``None``.",
      "properties": {
        "day": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day"
        },
        "date_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Time"
        },
        "time_zone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Zone"
        }
      },
      "title": "ExternalEventTime",
      "type": "object"
    },
    "MailAddress": {
      "additionalProperties": false,
      "description": "One party to a message, as the mailbox shows it.",
      "properties": {
        "address": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Address",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "address"
      ],
      "title": "MailAddress",
      "type": "object"
    },
    "MailAttachment": {
      "additionalProperties": false,
      "description": "An attachment's name and size. Its content does not come in with the message.",
      "properties": {
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "content_type": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        }
      },
      "required": [
        "name"
      ],
      "title": "MailAttachment",
      "type": "object"
    },
    "MailChange": {
      "additionalProperties": false,
      "description": "A message to keep (``upsert``) or one the mailbox no longer has (``delete``).\n\nA mailbox often says only *which item* went, by its own id, so a delete names the item, the\nmessage, or both; Korsi finds the source by either.",
      "properties": {
        "op": {
          "enum": [
            "upsert",
            "delete"
          ],
          "title": "Op",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "$ref": "#/$defs/MailMessage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "provider_item_id": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Item Id"
        }
      },
      "required": [
        "op"
      ],
      "title": "MailChange",
      "type": "object"
    },
    "MailHeaders": {
      "additionalProperties": false,
      "description": "What a message is beyond its text: who, when, where it sits and how it threads (ADR-0067).\n\nKept beside the source so a person's mail can be read as mail -- by thread, by sender -- and so\na mailbox that moves or deletes a message can be followed: ``provider_item_id`` and ``folder``\nare the mailbox's own address for it, which changes when it moves.",
      "properties": {
        "message_id": {
          "anyOf": [
            {
              "maxLength": 998,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Id"
        },
        "thread_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "folder": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Folder"
        },
        "provider_item_id": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Item Id"
        },
        "sender": {
          "anyOf": [
            {
              "$ref": "#/$defs/MailAddress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "to": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MailAddress"
          },
          "maxItems": 500,
          "title": "To",
          "type": "array"
        },
        "cc": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MailAddress"
          },
          "maxItems": 500,
          "title": "Cc",
          "type": "array"
        },
        "sent_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sent At"
        },
        "received_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
