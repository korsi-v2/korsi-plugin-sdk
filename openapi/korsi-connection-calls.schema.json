          "type": "string"
        },
        "installation_id": {
          "format": "uuid",
          "title": "Installation Id",
          "type": "string"
        },
        "connection_id": {
          "format": "uuid",
          "title": "Connection Id",
          "type": "string"
        },
        "connection_key": {
          "maxLength": 48,
          "title": "Connection Key",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        },
        "locale": {
          "maxLength": 16,
          "title": "Locale",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "title": "Timezone",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Values",
          "type": "object"
        },
        "secrets": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Secrets",
          "type": "object"
        },
        "settings": {
          "additionalProperties": true,
          "title": "Settings",
          "type": "object"
        },
        "deadline_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Deadline Seconds",
          "type": "integer"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "op": {
          "enum": [
            "start",
            "finish"
          ],
          "title": "Op",
          "type": "string"
        },
        "redirect_uri": {
          "maxLength": 2000,
          "title": "Redirect Uri",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "code_challenge": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Challenge"
        },
        "code": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "code_verifier": {
